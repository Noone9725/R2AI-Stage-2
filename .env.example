# Copy sang .env roi dien gia tri thuc. KHONG commit .env.
#
#   cp .env.example .env
#
# Khoa bi mat CHI o day — configs/*.yaml duoc commit nen tuyet doi
# khong ghi token vao do.

# Token HuggingFace — can khi tai model gated (vd Llama).
# Model public (Qwen2.5, Vistral...) thi de trong duoc.
HF_TOKEN=

# API key cho backend "openai". Voi server self-host (vLLM/TGI) thuong
# de trong hoac dat "EMPTY" — code tu fallback sang "EMPTY".
#
# LUU Y THE LE: chi duoc dung LLM open-weight <= 14B, phat hanh truoc
# 2026-06-01. Bien nay la de tro toi endpoint TU HOST, khong phai de
# goi model dong (GPT-4o, Gemini... -> bi cham diem 0).
LLM_API_KEY=
